# ============================================================
# SGP-Pharma — Variables d'environnement Backend (.env.example)
# ============================================================

# Base locale (mongod installé sur le PC local de la pharmacie)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="HOP-Pharma"

# Cluster MongoDB Atlas (Synchronisation Cloud automatique)
MONGO_URL_ATLAS="mongodb+srv://<db_user>:<password>@<cluster>.mongodb.net/HOP-Pharma?retryWrites=true&w=majority"
SYNC_INTERVAL_SECONDS=15
SYNC_ENABLED=true

# Sécurité & Accès
CORS_ORIGINS="*"
JWT_SECRET="remplacer-par-une-cle-secrete-aleatoire-en-production"
ADMIN_EMAIL="admin@sgp-pharma.tg"
ADMIN_PASSWORD="Admin@2026"
SEED_DEMO="true"
